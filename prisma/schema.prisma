generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  slug      String
  productos Producto[]
}

model Producto {
  id          Int              @id @default(autoincrement())
  nombre      String
  precio      Float
  imagen      String
  idCategoria Int
  categoria   Categoria        @relation(fields: [idCategoria], references: [id])
  itemsOrden  ProductosOrden[]
}

model Orden {
  id             Int              @id @default(autoincrement())
  nombre         String
  total          Float
  fecha          DateTime         @default(now())
  estado         Boolean          @default(false)
  ordenListaAt   DateTime?
  productosOrden ProductosOrden[]
}

model ProductosOrden {
  id         Int      @id @default(autoincrement())
  idOrden    Int
  orden      Orden    @relation(fields: [idOrden], references: [id])
  idProducto Int
  producto   Producto @relation(fields: [idProducto], references: [id])
  cantidad   Int
}
