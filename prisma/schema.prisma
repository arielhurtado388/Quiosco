generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  slug      String
  productos Producto[]
}

model Producto {
  id          Int       @id @default(autoincrement())
  nombre      String
  precio      Float
  imagen      String
  idCategoria Int
  categoria   Categoria @relation(fields: [idCategoria], references: [id])
}
